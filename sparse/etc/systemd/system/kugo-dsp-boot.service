[Unit]
Description=Boot ADSP with RFS support (kugo)
Requires=mnt-fw.mount persist.mount
After=mnt-fw.mount persist.mount droid-hal-init.service

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'for f in /mnt/fw/image/*; do b=$(basename $f); [ -e /odm/firmware/$b ] || ln -s $f /odm/firmware/$b; done'
ExecStartPre=/bin/sh -c 'sleep 1'
ExecStart=/mnt/oem/bin/rmt_storage
ExecStartPost=/bin/sh -c 'sleep 3; echo 1 > /sys/kernel/boot_adsp/boot'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
