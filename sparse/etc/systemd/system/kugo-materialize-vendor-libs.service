[Unit]
Description=Materialize Android libs that symlink into /mnt (invisible in sailjail)
DefaultDependencies=no
After=local-fs.target mnt-oem.mount mnt-stock\x2dsystem.mount
Before=droid-hal-init.service sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/kugo-materialize-vendor-libs

[Install]
WantedBy=sysinit.target
