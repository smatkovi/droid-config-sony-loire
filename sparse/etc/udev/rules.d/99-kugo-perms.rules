# sensors.qcom (user system) needs its device node
KERNEL=="sensors", OWNER="system", GROUP="system", MODE="0660"
# camera stack (mm-qcamera-daemon + HAL run as camera)
KERNEL=="v4l-subdev*", OWNER="camera", GROUP="camera", MODE="0660"
KERNEL=="media*", OWNER="camera", GROUP="camera", MODE="0660"
KERNEL=="video*", OWNER="camera", GROUP="camera", MODE="0660"
