service rmt_storage /odm/bin/rmt_storage
    class core
    user root
    group system wakelock
    ioprio rt 0

service per_mgr /odm/bin/pm-service
    class core
    user system
    group system

service per_proxy /odm/bin/pm-proxy
    class core
    user system
    group system
    disabled

on property:init.svc.per_mgr=running
    start per_proxy

service sct_service /odm/bin/sct_service
    class core
    user root

service qseecomd_kugo /odm/bin/qseecomd
    class core
    user root
    group root

service irsc_util /odm/bin/irsc_util "/mnt/oem/etc/sec_config"
    class main
    user root
    oneshot

service qmuxd /odm/bin/qmuxd
    class main
    user radio
    group radio audio bluetooth wakelock gps nfc diag

service ril-daemon /vendor/bin/hw/rild
    class main
    user radio
    group radio cache inet misc audio log readproc wakelock
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
